    <string name="feature_auth_password_change_title">Change your password</string>
    <string name="feature_auth_password_change_required_title">Time for a new password</string>
    <string name="feature_auth_password_change_required_message">To keep your account safe, we ask for a new password when you first sign in and every six months after that.</string>
    <string name="feature_auth_password_change_voluntary_message">Enter your current password, then pick a new one. You\'ll stay signed in here.</string>
    <string name="feature_auth_current_password_label">Current password</string>
    <string name="feature_auth_new_password_label">New password</string>
    <string name="feature_auth_new_password_hint" tools:ignore="PluralsCandidate">At least %1$d characters. A short phrase is easy to remember.</string>
    <string name="feature_auth_confirm_password_label">Confirm new password</string>
    <string name="feature_auth_password_change_save">Update password</string>
    <string name="feature_auth_password_change_saving">Saving your new password…</string>
    <string name="feature_auth_password_change_failed_title">Your password wasn\'t changed</string>
    <string name="feature_auth_password_change_done_title">You\'re all set</string>
    <string name="feature_auth_password_change_done_message">Use your new password next time you sign in.</string>
