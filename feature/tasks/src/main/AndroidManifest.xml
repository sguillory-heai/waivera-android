<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Shares one task file at a time with the app the person picks, and gives the camera
            app one file to write a photo into. Only the feature_tasks_share and
            feature_tasks_camera cache folders are exposed, and only through granted uris.
        -->
        <provider
            android:name="com.waivera.waivera.feature.tasks.files.TaskFileProvider"
            android:authorities="${applicationId}.feature.tasks.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/feature_tasks_file_paths" />
        </provider>
    </application>

</manifest>
