<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere, also on Android 8, where the platform still allows it by default. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
